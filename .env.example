OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Oracle: use EITHER ORACLE_DSN OR the split variables below (not both needed).
# If ORACLE_DSN is set (non-empty), it is used and host/port/service are ignored.
#
# Option A — single DSN for python-oracledb (not the SQLcl -name alias).
# Easy Connect (no tnsnames.ora): host:port/service_name  e.g. db.example.com:1521/ORCLPDB1
# TNS alias: short name that must exist in tnsnames.ora under ORACLE_CLIENT_CONFIG_DIR or TNS_ADMIN
ORACLE_DSN=
# Option B — Easy Connect from parts (avoids ORA-12154 when you have no tnsnames alias)
# ORACLE_HOST=db.example.com
# ORACLE_PORT=1521
# ORACLE_SERVICE_NAME=ORCLPDB1
ORACLE_RO_USER=
ORACLE_RO_PASSWORD=
ORACLE_CLIENT_MODE=thick
ORACLE_CLIENT_LIB_DIR=
ORACLE_CLIENT_CONFIG_DIR=
SCHEMA_PATH=data/schema.json
# Max characters of schema text sent to the model (retrieval trim).
SCHEMA_PROMPT_CHAR_BUDGET=20000
# Used by tools.find_relevant_tables to bound the per-question schema slice.
SCHEMA_RETRIEVAL_MAX_TABLES=12
SCHEMA_RETRIEVAL_FUZZY_CUTOFF=0.42
# Used by tools.run_select_sql to retry once after a schema-mismatch error.
SQL_CURE_VALIDATE_ENABLED=true
CHAT_RATE_LIMIT_ENABLED=true
CHAT_RATE_LIMIT_REQUESTS=30
CHAT_RATE_LIMIT_WINDOW_S=60
MAX_ROWS=1000
QUERY_TIMEOUT_S=30
HOST=127.0.0.1
PORT=8000

# === LangGraph agent stack (oracle-sqlcl-chat port) ===
# Alternate LLM provider. Set ANTHROPIC_API_KEY + ANTHROPIC_MODEL to use Claude.
# If both OPENAI_* and ANTHROPIC_* are set, the LLM factory prefers Anthropic.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# SQLcl in -mcp stdio mode. Leave SQLCL_PATH empty to skip the MCP bridge entirely.
# SQLCL_CONNECTIONS uses the same Oracle instance as ORACLE_DSN above. The format is
#   [name1,user/password@host:port/service][name2,user/password@host:port/service]
# SQLCL_PATH=
# SQLCL_CONNECTIONS=
# Optional: keep SQLcl's connection wallet inside the repo (project-local) so
# nothing leaks into ~/.dbtools. Recommended value: .sqlcl
# SQLCL_USER_DIR=.sqlcl

# Agent system + filesystem-memory prompts (defaults are sane; override for prod).
# SYSTEM_PROMPT=
# FILESYSTEM_PROMPT=

# NiceGUI session signing key (must be set to a real secret in production).
# NICEGUI_STORAGE_SECRET=

# Optional LangSmith tracing.
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
